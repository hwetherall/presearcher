--     'run_research_worker_frequent',
--     '*/30 9-18 * * 1-5',
--     'SELECT trigger_research_worker();'
-- );

-- Grant necessary permissions to the function
GRANT EXECUTE ON FUNCTION trigger_research_worker() TO postgres;
